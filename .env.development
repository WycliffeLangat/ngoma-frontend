# Local review uses the deployed Railway Django API so chart data, uploads,
# media, and database storage stay off this PC by default.
VITE_API_BASE=/api/v1
VITE_API_PROXY_TARGET=https://web-production-0f6b5.up.railway.app

# To test a local Django backend instead, create an ignored .env.local with:
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
