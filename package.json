{
  "name": "ngoma-charts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kenya's official multi-platform music charts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "powershell -ExecutionPolicy Bypass -File scripts/build-android-bundle.ps1",
    "test": "node --test src/**/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
